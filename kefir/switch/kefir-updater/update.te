p("Done")
wait(tw = 1000)

if (fsexists("sd:/kefir")) {
	# 2. Копируем кефир на карту 
	clear()
	p("* Copy kefir to SD")

	# Sysmodules that are not in the new Kefir lose boot2.flag: one built for an older
	# Atmosphere can hang the boot (black screen). Kefir Hub can turn them back on.
	sysDir = "sd:/atmosphere/contents"
	if (fsexists(sysDir)) {
		sysList = readdir(sysDir)
		sysDirs = sysList.folders.copy()
		sysDirs.foreach("sysName") {
			sysFlag = sysDir + "/" + sysName + "/flags/boot2.flag"
			if (fsexists(sysFlag)) {
				if (!fsexists("sd:/kefir/atmosphere/contents/" + sysName)) {
					delfile(sysFlag)
					p("  Sysmodule turned off: " + sysName)
				}
			}
		}
	}

	deldir("sd:/kefir/switch/kefirupdater/")
	# bootloader goes first: after a failed copy hekate still starts this update again.
	copyErr = copydir("sd:/kefir/bootloader", "sd:/")
	if (!copyErr) { copyErr = copydir("sd:/kefir/atmosphere", "sd:/") }
	if (!copyErr) { copyErr = copydir("sd:/kefir/config", "sd:/") }
	if (!copyErr) { copyErr = copydir("sd:/kefir/switch", "sd:/") }
	if (!copyErr) { copyErr = copyfile("sd:/atmosphere/reboot_payload.bin", "sd:/payload.bin") }
	if (!copyErr) {
		if (boot) { copyErr = copyfile("sd:/kefir/boot.dat", "sd:/boot.dat") }
	}
	if (copyErr) {
		# Keep /kefir and the update boot: the next start copies again.
		p()
		p("Copy error " + copyErr.str() + ". The SD card can be full.")
		p("Hold POWER to turn the console off. Free space on the SD card.")
		p("Turn the console on: the update starts again.")
		pe()
	}
	copydir("sd:/kefir/games", "sd:/")

	if(boot) {
		copyfile("sd:/kefir/boot.ini", "sd:/boot.ini")
	}

	if(pegascape) {
		copydir("sd:/kefir/pegascape", "sd:/")
	}
	
	copyfile("sd:/kefir/exosphere.ini", "sd:/exosphere.ini")
	copyfile("sd:/kefir/hbmenu.nro", "sd:/hbmenu.nro")
	copyfile("sd:/kefir/keys.txt", "sd:/keys.txt")
	delfile("sd:/atmosphere/stratosphere.romfs.aio");
	delfile("sd:/atmosphere/fusee-secondary.bin.aio");
	delfile("sd:/sept/payload.bin.aio");
	delfile("sd:/payload.bin.aio");
	p()
	p("Done")
	wait(tw = 1000)
}

delfile("sd:/config/uberhand/packages/settings/stock")

if (fsexists("sd:/emummc/emummc.ini_bkp")) {
	movefile("sd:/emummc/emummc.ini_bkp", "sd:/emummc/emummc.ini")
}

