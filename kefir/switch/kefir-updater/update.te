# Kefir Hub: leftovers of an unfinished profile dump/restore. Completed packs, .zip backups,
# tegraexplorer/restore_backup and Undo_restore_if_wont_boot.te are kept.
hubPending = "sd:/config/kefir/restore_pending"
if (fsexists(hubPending)) { deldir(hubPending) }
hubNt = "sd:/config/kefir/nand_transfer"
if (fsexists(hubNt)) {
	hubList = readdir(hubNt)
	hubDirs = hubList.folders.copy()
	hubDirs.foreach("hubName") {
		hubParts = hubName.split("_staging_")
		if (hubParts.len() > 1) { if (hubParts[0] == "") { deldir(hubNt + "/" + hubName) } }
		hubParts = hubName.split("_restore_")
		if (hubParts.len() > 1) { if (hubParts[0] == "") { deldir(hubNt + "/" + hubName) } }
	}
}
