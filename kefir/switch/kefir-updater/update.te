p=println
pe={pause() exit()}
boot=0
syscon=0
missioncontrol=0
maj=0
pegascape=0
oc=0
emunand=1

wait={t=timer()while(timer()<(t+tw)){print()}}

if (is_erista()){
	if (fsexists("sd:/switch/prod.keys")) 
	{
		fwstr={fw=maj.str()+"."+min.str()+"."+pat.str()}
		fv={a=readsave("bis:/save/8000000000000120")
		b=a.read("/meta/imkvdb.arc")
		c=["BYTE[]",9,8,0,0,0,0,0,1]
		d=b.find(c)
		if(d>0){
			e=b.slice(d+8,4).project()
			ver=(e[3]<<24)|(e[2]<<16)|(e[1]<<8)|(e[0])
			pat=((ver>>16)&((1<<4)- 1))
			min=((ver>>20)&((1<<6)- 1))
			maj=((ver>>26)&((1<<6)- 1))
		}.else(){print("Fw not found")pe()}
		a=0 fwstr()}
		if(mountsys("SYSTEM")){maj=0}
		fv()
	}
}

boot=fsexists("sd:/boot.dat")
pegascape=fsexists("sd:/pegascape")
syscon=fsexists("sd:/atmosphere/contents/690000000000000D/flags/boot2.flag")
missioncontrol=fsexists("sd:/atmosphere/contents/010000000000bd00/flags/boot2.flag")

# Check the new Kefir before anything is deleted: an incomplete /kefir must not
# leave the SD card without boot files (black screen).
if (fsexists("sd:/kefir")) {
	kefirBad = 0
	kefirNeed = ["atmosphere/package3", "atmosphere/stratosphere.romfs", "atmosphere/reboot_payload.bin", "bootloader/payloads/fusee.bin", "bootloader/hekate_ipl.ini", "bootloader/hekate_ipl_.ini"]
	kefirNeed.foreach("kefirFile") {
		if (!fsexists("sd:/kefir/" + kefirFile)) {
			p("Missing: /kefir/" + kefirFile)
			kefirBad = 1
		}
	}
	if (boot) {
		if (!fsexists("sd:/kefir/boot.dat")) {
			p("Missing: /kefir/boot.dat")
			kefirBad = 1
		}
	}
	if (kefirBad) {
		p()
		p("The update files are incomplete. Nothing was changed.")
		# Leave the update boot only when the normal hekate config can come back.
		if (fsexists("sd:/kefir/bootloader/hekate_ipl_.ini")) {
			copyfile("sd:/kefir/bootloader/hekate_ipl_.ini", "sd:/bootloader/hekate_ipl.ini")
			delfile("sd:/bootloader/ini/!kefir_updater.ini")
			deldir("sd:/kefir")
			p("Download the update again.")
		}
		pe()
	}
}

if (fsexists("sd:/switch/DBI/dbi.config")) {
	if (fsexists("sd:/switch/DBI/dbi.config_")) {
		delfile("sd:/switch/DBI/dbi.config_")
	}
    copyfile("sd:/switch/DBI/dbi.config", "sd:/switch/DBI/dbi.config_")
}

